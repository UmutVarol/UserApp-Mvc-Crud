@model UserApp.Entities.Kullanici

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0 fw-bold">Yeni Kullanıcı Kaydı</h3>
                </div>
                <div class="card-body p-4">
                    <form action="/Home/Create" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ad</label>
                            <input type="text" name="Ad" class="form-control" placeholder="Ad giriniz" />
                            <span asp-validation-for="Ad" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Soyad</label>
                            <input type="text" name="Soyad" class="form-control" placeholder="Soyad giriniz" />
                            <span asp-validation-for="Soyad" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="ornek@mail.com" />
                            <span asp-validation-for="Email" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Departman</label>
                            <input type="text" name="Departman" class="form-control" placeholder="Ör: IT, Muhasebe" />
                            <span asp-validation-for="Departman" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">Kullanıcıyı Kaydet</button>
                            <a href="/Home/Index" class="btn btn-light border">Listeye Geri Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>