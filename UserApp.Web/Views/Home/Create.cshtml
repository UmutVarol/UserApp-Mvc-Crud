@model UserApp.Entities.Dtos.KullaniciCreateDto
@{ ViewData["Title"] = "Yeni Kullanıcı"; }

<div class="breadcrumb-admin"><a asp-action="Index">Panel</a> / Yeni Kullanıcı</div>
<h1 class="page-title">Yeni Kullanıcı Ekle</h1>

<div class="admin-card">
    <div class="admin-card-header">Genel Bilgiler</div>
    <div class="admin-card-body">
        <!-- enctype="multipart/form-data" eklendi: Bu olmadan dosya C# tarafına gidemez! -->
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- DOSYA YÜKLEME ALANI (accept filtresi ile sadece resim seçtirir) -->
                <div class="col-12 mb-2">
                    <label asp-for="ProfileImage" class="form-label fw-bold">Profil Fotoğrafı</label>
                    <input asp-for="ProfileImage" type="file" class="form-control" accept="image/png, image/jpeg, image/jpg" />
                    <div class="form-text text-muted">Maksimum 5 MB boyutunda, .jpg veya .png formatında resim yükleyebilirsiniz. (Zorunlu Değil)</div>
                </div>

                <div class="col-md-6">
                    <label asp-for="Ad" class="form-label">Ad</label>
                    <input asp-for="Ad" class="form-control" placeholder="Ad giriniz" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Soyad" class="form-label">Soyad</label>
                    <input asp-for="Soyad" class="form-control" placeholder="Soyad giriniz" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="ornek@mail.com" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DepartmanId" class="form-label">Departman</label>
                    <select asp-for="DepartmanId" asp-items="ViewBag.Departmanlar" class="form-select">
                        <option value="">-- Departman Seçiniz --</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-admin-outline">Vazgeç</a>
                <button type="submit" class="btn btn-admin-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>