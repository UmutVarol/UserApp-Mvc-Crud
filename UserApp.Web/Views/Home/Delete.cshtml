@model UserApp.Entities.Kullanici
@{ ViewData["Title"] = "Kullanıcıyı Sil"; }

<div class="breadcrumb-admin"><a asp-action="Index">Panel</a> / Sil</div>
<h1 class="page-title">Kullanıcıyı Sil</h1>

<div class="admin-card" style="max-width:480px;">
    <div class="admin-card-body text-center p-4">
        <div class="warn-icon-plain">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 3l10 18H2L12 3z"/><path d="M12 10v4"/><circle cx="12" cy="17" r=".5" fill="currentColor"/>
            </svg>
        </div>
        <h5 class="mb-2">"@Model.Ad @Model.Soyad" silinsin mi?</h5>
        <p class="text-muted mb-4">Bu işlem geri alınamaz.</p>

        <div class="text-start mb-4">
            <div class="info-row"><span class="info-label">Email</span><span class="info-value">@Model.Email</span></div>
            <div class="info-row"><span class="info-label">Departman</span><span class="info-value">@Model.Departman?.Ad</span></div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-grid gap-2">
            <button type="submit" class="btn btn-admin-danger">Evet, Kalıcı Olarak Sil</button>
            <a asp-action="Index" class="btn btn-admin-outline">Vazgeç</a>
        </form>
    </div>
</div>