@model UserApp.Entities.Dtos.KullaniciDetailDto
@{ ViewData["Title"] = "Kullanıcı Detayı"; }

<div class="breadcrumb-admin"><a asp-action="Index">Panel</a> / Detay</div>
<h1 class="page-title">@Model.Ad @Model.Soyad</h1>

<div class="admin-card" style="max-width:520px;">
    <div class="admin-card-header">Kullanıcı Bilgileri</div>
    <div class="admin-card-body">
        <div class="info-row"><span class="info-label">Ad Soyad</span><span class="info-value">@Model.Ad @Model.Soyad</span></div>
        <div class="info-row"><span class="info-label">Email</span><span class="info-value">@Model.Email</span></div>
        <div class="info-row"><span class="info-label">Departman</span><span class="dept-pill">@Model.DepartmanAdi</span></div>
        <div class="info-row"><span class="info-label">Kayıt No</span><span class="info-value">#@Model.Id</span></div>

        <div class="d-flex gap-2 justify-content-end mt-4">
            <a asp-action="Index" class="btn btn-admin-outline">Listeye Dön</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-admin-primary">Düzenle</a>
        </div>
    </div>
</div>