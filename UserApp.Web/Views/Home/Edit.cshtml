@model UserApp.Entities.Dtos.KullaniciEditDto
@{ ViewData["Title"] = "Kullanıcıyı Düzenle"; }

<div class="breadcrumb-admin"><a asp-action="Index">Panel</a> / Düzenle</div>
<h1 class="page-title">Kullanıcıyı Düzenle</h1>

<div class="admin-card">
    <div class="admin-card-header">Genel Bilgiler</div>
    <div class="admin-card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3 align-items-center mb-3">
                <!-- MEVCUT FOTOĞRAF ÖNİZLEMESİ -->
                <div class="col-md-3 text-center">
                    <div class="mb-2">
                        <span class="text-muted small d-block mb-1">Mevcut Fotoğraf</span>
                        @{
                            var avatarSrc = !string.IsNullOrEmpty(Model.ProfileImagePath) 
                                ? Model.ProfileImagePath 
                                : $"https://ui-avatars.com/api/?name={Model.Ad}+{Model.Soyad}&background=random&color=fff";
                        }
                        <img src="@avatarSrc" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover; border: 2px solid #dee2e6;" alt="Avatar" />
                    </div>
                </div>

                <!-- DOSYA SEÇME ALANI -->
                <div class="col-md-9">
                    <label asp-for="ProfileImage" class="form-label fw-bold">Profil Fotoğrafını Değiştir</label>
                    <input asp-for="ProfileImage" type="file" class="form-control" accept="image/png, image/jpeg, image/jpg" />
                    <div class="form-text text-muted">Yeni bir dosya seçmezseniz mevcut fotoğrafınız geçerli kalacaktır.</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Ad" class="form-label">Ad</label>
                    <input asp-for="Ad" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Soyad" class="form-label">Soyad</label>
                    <input asp-for="Soyad" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DepartmanId" class="form-label">Departman</label>
                    <select asp-for="DepartmanId" asp-items="ViewBag.Departmanlar" class="form-select"></select>
                </div>

                <!-- HESAP DURUMU: Aktif/Pasif Toggle Switch -->
                <div class="col-md-6">
                    <label class="form-label d-block">Hesap Durumu</label>
                    <div class="form-check form-switch fs-5 mt-2">
                        <input class="form-check-input" type="checkbox" role="switch"
                               asp-for="IsActive" id="isActiveSwitch" />
                        <label class="form-check-label" for="isActiveSwitch">
                            <span id="isActiveLabel">@(Model.IsActive ? "Aktif" : "Pasif")</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-admin-outline">Vazgeç</a>
                <button type="submit" class="btn btn-admin-primary">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Switch değiştikçe yanındaki metni ("Aktif"/"Pasif") anlık günceller.
        // Sunucuya hiçbir etkisi yoktur, sadece görsel geri bildirimdir.
        document.getElementById('isActiveSwitch').addEventListener('change', function () {
            document.getElementById('isActiveLabel').textContent = this.checked ? 'Aktif' : 'Pasif';
        });
    </script>
}