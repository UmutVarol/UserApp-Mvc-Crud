@model UserApp.Web.Models.KullaniciListViewModel
@{ ViewData["Title"] = "Panel"; }

<!-- DATATABLES BOOTSTRAP 5 VE BUTTONS CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">

<div class="breadcrumb-admin">Panel</div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">Kullanıcı Yönetimi</h1>
    <a asp-action="Create" class="btn btn-admin-primary">+ Yeni Kullanıcı</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.ToplamKullanici</div>
            <div class="stat-label">Toplam Kullanıcı</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.DepartmanSayisi</div>
            <div class="stat-label">Departman Sayısı</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="stat-card">
            <div class="stat-value" style="font-size:1.1rem;">@(Model.SonEklenenAdSoyad ?? "—")</div>
            <div class="stat-label">Son Eklenen</div>
        </div>
    </div>
</div>

<!-- KULLANICI LİSTESİ TABLOSU -->
<div class="admin-card">
    <div class="admin-card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span>Kullanıcı Listesi</span>
    </div>

    <div class="table-responsive p-3">
        <!-- DataTables JS'in kullanacağı tabloya "data-url" ile güvenli rota verildi -->
        <table id="kullaniciTable" class="table admin-table mb-0 w-100" data-url="@Url.Action("GetKullanicilarJson", "Home")">
            <thead>
                <tr>
                    <th class="ps-4" style="width: 20%;">İşlemler</th> <!-- İŞLEMLER SOLA ALINDI -->
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Departman</th>
                    <th>Kayıt Tarihi</th>
                    <th class="text-end pe-4">Durum</th>
                </tr>
            </thead>
            <tbody>
                <!-- JS AJAX ile doldurulacak -->
            </tbody>
        </table>
    </div>
</div>

<!-- SİLME MODALI -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-card border-0">
            <div class="admin-card-body text-center p-4">
                <div class="warn-icon-plain">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 3l10 18H2L12 3z"/><path d="M12 10v4"/><circle cx="12" cy="17" r=".5" fill="currentColor"/>
                    </svg>
                </div>
                <h5 class="mb-2">"<span id="deleteModalUserName"></span>" silinsin mi?</h5>
                <p class="text-muted mb-4">Bu işlem geri alınamaz.</p>
                <form id="deleteModalForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-admin-danger">Evet, Sil</button>
                        <button type="button" class="btn btn-admin-outline" data-bs-dismiss="modal">Vazgeç</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- BİZİM DETAY MODALIMIZ (Kurumsal Kimliğe Uyarlandı) -->
<div class="modal fade" id="detayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-card border-0">
            <div class="admin-card-header text-center">
                <h5 class="mb-0">Kullanıcı Detayları</h5>
            </div>
            <div class="admin-card-body p-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Ad Soyad:</span>
                    <strong id="modalAdSoyad"></strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Email:</span>
                    <strong id="modalEmail"></strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Departman:</span>
                    <span id="modalDepartman" class="dept-pill"></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Kayıt Tarihi:</span>
                    <strong id="modalKayitTarihi"></strong>
                </div>
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Durum:</span>
                    <strong id="modalDurum"></strong>
                </div>
                <div class="d-grid">
                    <button type="button" class="btn btn-admin-outline" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- JQUERY  -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    
    <!-- DATATABLES & BUTTONS EKLENTİLERİ -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script> 
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js"></script>

    <!-- 2. CACHE BUSTING: asp-append-version="true" tarayıcı önbellek sorununu tamamen bitirir -->
    <script src="~/js/kullanici-datatable.js" asp-append-version="true"></script>

    <!-- 3. MODÜL İNŞASI: JS kodları içeri gömülmez, sadece ilgili konfigürasyonlarla başlatılır -->
    <script>
        $(document).ready(function () {
            KullaniciTableModule.init({
                tableSelector: '#kullaniciTable',
                modalSelector: '#detayModal',
                deleteModalSelector: '#deleteModal'
            });
        });
    </script>
}