@model UserApp.Web.Models.KullaniciListViewModel
@{ ViewData["Title"] = "Panel"; }

<div class="breadcrumb-admin">Panel</div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">Kullanıcı Yönetimi</h1>
    <a asp-action="Create" class="btn btn-admin-primary">+ Yeni Kullanıcı</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.ToplamKullanici</div>
            <div class="stat-label">Toplam Kullanıcı</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="stat-card">
            <div class="stat-value">@Model.DepartmanSayisi</div>
            <div class="stat-label">Departman Sayısı</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="stat-card">
            <div class="stat-value" style="font-size:1.1rem;">@(Model.SonEklenen != null ? $"{Model.SonEklenen.Ad} {Model.SonEklenen.Soyad}" : "—")</div>
            <div class="stat-label">Son Eklenen</div>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span>Kullanıcı Listesi</span>
        <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2">
            <input type="text" name="q" value="@Model.SearchTerm" class="form-control form-control-sm" style="max-width:220px;" placeholder="Ara..." />
            <select name="sort" class="form-select form-select-sm" style="max-width:170px;" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Ada göre (A-Z)</option>
                <option value="ad_desc" selected="@(Model.SortBy == "ad_desc")">Ada göre (Z-A)</option>
                <option value="departman" selected="@(Model.SortBy == "departman")">Departmana göre</option>
                <option value="son_eklenen" selected="@(Model.SortBy == "son_eklenen")">Son eklenen önce</option>
            </select>
            <button type="submit" class="btn btn-admin-outline btn-sm">Ara</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-admin-outline btn-sm">Temizle</a>
            }
        </form>
    </div>

    <div class="table-responsive d-none d-md-block">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Ad Soyad</th>
                    <th>Email</th>
                    <th>Departman</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-5">Kayıt bulunamadı.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@item.Ad @item.Soyad</td>
                        <td class="text-muted">@item.Email</td>
                        <td><span class="dept-pill">@item.Departman?.Ad</span></td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-admin-outline btn-sm me-1">Düzenle</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-admin-outline btn-sm me-1">Detay</a>
                            <button type="button" class="btn btn-admin-danger-soft btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-id="@item.Id" data-name="@item.Ad @item.Soyad">
                                Sil
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none p-3 d-grid gap-2">
        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted py-4">Kayıt bulunamadı.</div>
        }
        @foreach (var item in Model.Items)
        {
            <div class="border rounded-3 p-3" style="border-color:var(--border) !important;">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold">@item.Ad @item.Soyad</div>
                        <div class="text-muted small">@item.Email</div>
                    </div>
                    <span class="dept-pill flex-shrink-0">@item.Departman?.Ad</span>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-admin-outline btn-sm flex-fill">Düzenle</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-admin-outline btn-sm flex-fill">Detay</a>
                    <button type="button" class="btn btn-admin-danger-soft btn-sm flex-fill"
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-id="@item.Id" data-name="@item.Ad @item.Soyad">
                        Sil
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center gap-2 flex-wrap mb-4">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-sort="@Model.SortBy" asp-route-page="@p"
               class="btn btn-sm @(p == Model.Page ? "btn-admin-primary" : "btn-admin-outline")">@p</a>
        }
    </nav>
}

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-card border-0">
            <div class="admin-card-body text-center p-4">
                <div class="warn-icon-plain">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 3l10 18H2L12 3z"/><path d="M12 10v4"/><circle cx="12" cy="17" r=".5" fill="currentColor"/>
                    </svg>
                </div>
                <h5 class="mb-2">"<span id="deleteModalUserName"></span>" silinsin mi?</h5>
                <p class="text-muted mb-4">Bu işlem geri alınamaz.</p>
                <form id="deleteModalForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-admin-danger">Evet, Sil</button>
                        <button type="button" class="btn btn-admin-outline" data-bs-dismiss="modal">Vazgeç</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            document.getElementById('deleteModalUserName').textContent = button.getAttribute('data-name');
            document.getElementById('deleteModalForm').action = '/Home/Delete/' + button.getAttribute('data-id');
        });
    </script>
}