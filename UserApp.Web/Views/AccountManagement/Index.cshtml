@model List<UserApp.Web.Models.UserAccountListItemViewModel>
@{ ViewData["Title"] = "Hesap Yönetimi"; }

<div class="breadcrumb-admin">Panel / Hesap Yönetimi</div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">Hesap Yönetimi</h1>
    <a asp-action="Create" class="btn btn-admin-primary">+ Yeni Hesap</a>
</div>

<div class="admin-card">
    <div class="admin-card-header">Sisteme Giriş Yapabilen Hesaplar</div>
    <div class="table-responsive p-3">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Bağlı Personel</th>
                    <th>Yönettiği Departman</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td><span class="dept-pill">@u.Rol</span></td>
                        <td>@(u.BagliPersonelAdSoyad ?? "—")</td>
                        <td>@(u.YonetilenDepartmanAdi ?? "—")</td>
                        <td class="text-end pe-4">
                            <a asp-action="EditRole" asp-route-id="@u.Id" class="btn btn-admin-outline btn-sm">Düzenle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>