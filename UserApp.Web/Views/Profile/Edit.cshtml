@model UserApp.Entities.Dtos.KullaniciSelfEditDto
@{ ViewData["Title"] = "Profilim"; }

<div class="breadcrumb-admin">Profilim</div>
<h1 class="page-title">Profilim</h1>

<div class="admin-card">
    <div class="admin-card-header">Kendi Bilgilerim</div>
    <div class="admin-card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3 align-items-center mb-3">
                <div class="col-md-3 text-center">
                    <div class="mb-2">
                        <span class="text-muted small d-block mb-1">Mevcut Fotoğraf</span>
                        @{
                            var avatarSrc = !string.IsNullOrEmpty(Model.ProfileImagePath)
                                ? Model.ProfileImagePath
                                : $"https://ui-avatars.com/api/?name={Model.Ad}+{Model.Soyad}&background=random&color=fff";
                        }
                        <img src="@avatarSrc" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover; border: 2px solid #dee2e6;" alt="Avatar" />
                    </div>
                </div>

                <div class="col-md-9">
                    <label asp-for="ProfileImage" class="form-label fw-bold">Profil Fotoğrafını Değiştir</label>
                    <input asp-for="ProfileImage" type="file" class="form-control" accept="image/png, image/jpeg, image/jpg" />
                    <div class="form-text text-muted">Yeni bir dosya seçmezseniz mevcut fotoğrafınız geçerli kalacaktır.</div>
                </div>
            </div>

            <div class="row g-3">
                <!-- SALT-OKUNUR ALANLAR: <input> DEĞİL, düz metin. Bu alanlar
                     hiçbir zaman POST edilmez, bu yüzden Ad/Soyad/Departman'ı
                     değiştirmenin hiçbir yolu yoktur (görsel kısıtlama değil,
                     yapısal kısıtlama). Değiştirmek isterseniz departman
                     yöneticinize veya sistem yöneticisine başvurmalısınız. -->
                <div class="col-md-6">
                    <label class="form-label">Ad</label>
                    <input type="text" class="form-control" value="@Model.Ad" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Soyad</label>
                    <input type="text" class="form-control" value="@Model.Soyad" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Departman</label>
                    <input type="text" class="form-control" value="@Model.DepartmanAdi" disabled />
                </div>
            </div>

            <div class="form-text text-muted mt-2">
                Ad, Soyad ve Departman bilgilerinizi değiştirmek için lütfen departman yöneticinizle iletişime geçin.
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <button type="submit" class="btn btn-admin-primary">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
</div>